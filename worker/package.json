{
  "name": "cti-alerts-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SecurityCyber CTI Alerts — public subscription service (Cloudflare Worker)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:local": "wrangler d1 execute cti-subs --local --file schema.sql",
    "db:remote": "wrangler d1 execute cti-subs --remote --file schema.sql",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node test/run.mjs && node test/db.mjs",
    "test:flow": "node test/flow.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.128.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260831.1": true
  }
}
