# Podman Quadlet — the Threatintel harvest as a scheduled container.
# Fired by threatintel.timer (every 4h). Bind-mounts live config + state +
# the host's claude auth so nothing secret is in the image.
#
# Install (rootless):
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/threatintel.container deploy/threatintel.timer deploy/threatintel-panel.container ~/.config/containers/systemd/
#   podman build -t threatintel:latest -f deploy/Containerfile ~/Threatintel
#   systemctl --user daemon-reload && systemctl --user start threatintel.timer

[Unit]
Description=SecurityCyber CTI pipeline (one harvest)
After=network-online.target

[Container]
Image=localhost/threatintel:latest
AutoUpdate=local
Volume=%h/Threatintel/config:/app/config:z
Volume=%h/Threatintel/state:/app/state:z
Volume=%h/Threatintel/logs:/app/logs:z
Volume=%h/Threatintel/drafts:/app/drafts:z
# claude CLI OAuth (read-write: it refreshes tokens)
Volume=%h/.claude:/root/.claude:z
Volume=%h/.claude.json:/root/.claude.json:z
Environment=CTI_TRIGGER=timer
Environment=PYTHONUNBUFFERED=1
Environment=DISABLE_AUTOUPDATER=1
# no outbound network limits — the analyst needs WebFetch
Network=pasta

[Service]
Type=oneshot
TimeoutStartSec=1800

# started by the .timer, not on boot
