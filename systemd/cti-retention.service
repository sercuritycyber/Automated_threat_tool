[Unit]
Description=Blue Team CTI — subscriber data-retention purge

[Service]
Type=oneshot
WorkingDirectory=%h/Threatintel
ExecStart=/usr/bin/env python3 %h/Threatintel/bin/retention.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=300
Nice=15

[Install]
WantedBy=default.target
