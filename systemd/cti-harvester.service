[Unit]
Description=Blue Team Podcast CTI harvester + LinkedIn publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Threatintel
ExecStart=/usr/bin/env bash %h/Threatintel/bin/run.sh
# claude + user pip installs live in ~/.local/bin
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# don't let a single run wedge the timer forever
TimeoutStartSec=1200
Nice=10

[Install]
WantedBy=default.target
