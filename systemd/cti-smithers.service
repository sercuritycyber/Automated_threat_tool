[Unit]
Description=SecurityCyber Smithers — read-only pipeline health report to Paperclip
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Threatintel
ExecStart=/usr/bin/env python3 %h/Threatintel/bin/smithers_report.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=180
Nice=15
