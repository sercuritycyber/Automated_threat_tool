[Unit]
Description=SecurityCyber CTI post-run audit — verify the social funnel is still intact
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Threatintel
ExecStart=/usr/bin/env python3 %h/Threatintel/bin/post_run_audit.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=600
Nice=15

[Install]
WantedBy=default.target
