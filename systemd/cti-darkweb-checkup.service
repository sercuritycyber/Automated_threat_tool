[Unit]
Description=SecurityCyber onion liveness checkup (re-validate tracked addresses over Tor)
Documentation=file:%h/Threatintel/darkweb/README.md
After=network-online.target tor.service
Wants=network-online.target tor.service

# Lighter companion to cti-darkweb.service: re-checks already-known addresses
# (no crawl), so a tracked DOWN site is noticed coming back quickly. Same no-exec
# sandbox: NoExecPaths=/ + narrow ExecPaths means it can run python but cannot
# exec bash/sudo/anything else.

[Service]
Type=oneshot
WorkingDirectory=%h/Threatintel
ExecStart=/usr/bin/python3 %h/Threatintel/darkweb/harvest.py checkup

NoExecPaths=/
ExecPaths=/usr/bin/python3 /usr/bin/python3.14 /usr/lib64 /usr/lib /lib64 /etc/ld.so.cache
SystemCallFilter=@system-service
SystemCallArchitectures=native
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ReadWritePaths=/mnt/data/threatintel/darkweb
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077

TimeoutStartSec=900
Nice=12

[Install]
WantedBy=default.target
