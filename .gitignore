# secrets
config/env
config/settings.yaml

# runtime state & output
state/*
!state/.gitkeep
drafts/*
!drafts/.gitkeep
logs/*
!logs/.gitkeep

# python
__pycache__/
*.pyc
.venv/

# subscription service — PII, never commit
state/subscribers.db
state/subscribers.db-*
state/subscribers.db.*
config/subscribers.json
state/backups/

# cloudflare worker
worker/node_modules/
worker/.wrangler/
worker/.dev.vars
worker/package-lock.json

# local drop-ins — never commit
ssh-key-*.key
*.pem
gemini-code-*.html
Gemini_Generated_Image*

# dark-web aggregator — local config may hold verified onion addresses; never commit
darkweb/sources.yaml
darkweb/watchlist.yaml
darkweb/safety_blocklist_*.txt

# machine-local (VM)
/.agent-bus
/state
/logs
/drafts
config/env.bak.*
reports/
