# Copy to  config/env  and fill in.  `config/env` is git-ignored.
#   cp config/env.example config/env && chmod 600 config/env

# --- LinkedIn (required to actually post) --------------------------------
# A 3-legged OAuth access token with the "w_member_social" scope, plus
# "openid profile" if you want the author URN auto-detected.
LINKEDIN_ACCESS_TOKEN=

# Optional: skip the /v2/userinfo lookup by pinning your member URN.
#   urn:li:person:XXXXXXXX
LINKEDIN_AUTHOR_URN=

# Optional: enables automatic access-token refresh when it 401s.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=

# --- Other social networks (optional — see publish.targets) -------------
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Email (brand's own posts and subscriber alerts) ------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
# EMAIL_TO is only the brand's own channel; subscriber addresses live in
# the subscriber DB, never here.
EMAIL_TO=

# --- Overrides (optional) ----------------------------------------------
# Force dry-run on/off regardless of settings.yaml.
CTI_DRY_RUN=true

# Failure/health notification endpoint (overrides settings.yaml notify.ntfy_url)
NTFY_URL=

# ======================================================================
#  Paid subscription service
# ======================================================================
#
#  PRODUCTION runs as the Cloudflare Worker in worker/ (deploy target
#  cti.securitycyber.uk). The pipeline just POSTs its posts to the Worker,
#  and the owner panel reads/writes via the Worker's /admin API. Set:
CTI_WORKER_URL=            # https://cti.securitycyber.uk
CTI_INGEST_SECRET=         # matches the Worker's INGEST_SECRET  (bin/push_to_worker.py)
CTI_ADMIN_TOKEN=           # matches the Worker's ADMIN_TOKEN    (owner panel → /admin)
#
#  All other subscription secrets below live in the WORKER
#  (npx wrangler secret put ...), not here — kept for the legacy local
#  Python service (web/public_app.py, bin/deliver.py) only.

# Legacy local Python service — Turso (libSQL) for PII, else local SQLite (dev):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SUBS_TOKEN_SECRET=
SUBS_WEBHOOK_SIGNING_SECRET=
