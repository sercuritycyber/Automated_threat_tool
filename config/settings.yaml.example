# Template only — copy to config/settings.yaml and fill in real values.
# config/settings.yaml is gitignored (never commit it): it carries the
# owner's canarytoken as notify.ntfy_url. Never fetch or POST that URL.
brand:
  name: SecurityCyber
  site: securitycyber.uk
  audience: blue team operators, SOC analysts, and enterprise defenders
ingest:
  lookback_hours: 12
  feed_timeout_seconds: 20
  kev_recent_days: 21
  max_candidates: 40
scoring:
  min_score: 60
  subscriber_min_score: 12
analyst:
  engine: claude
  deep_pass: false
  # Backup engines when Claude is unavailable: Gemini (GEMINI_API_KEY), then
  # these OpenAI-compatible providers in order. A provider runs only with its
  # key in config/env AND a pinned model id: auto/"latest" routers swap the
  # model underneath us and the analysis quality with it. Backup output is
  # checked for invented CVEs and its public posts wait for approval.
  backup_review: true
  backup_providers:
  - {name: openrouter, base_url: https://openrouter.ai/api/v1, key_env: OPENROUTER_API_KEY, model: ""}
  - {name: openai, base_url: https://api.openai.com/v1, key_env: OPENAI_API_KEY, model: ""}
  - {name: mistral, base_url: https://api.mistral.ai/v1, key_env: MISTRAL_API_KEY, model: ""}
publish:
  mode: live
  dry_run: false
  max_post_chars: 2900
  linkedin_api_version: "202509"   # LinkedIn rotates these ~monthly; publisher auto-bumps on HTTP 426
  visibility: PUBLIC
notify:
  ntfy_url: https://REPLACE-WITH-YOUR-OWN-CANARYTOKEN-URL
  on_success: true
